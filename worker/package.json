{
  "name": "wp-collab-cloudflare-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "test": "node --test test/auth.test.mjs test/deployment-config.test.mjs test/limits.test.mjs",
    "test:runtime": "wrangler deploy --dry-run --env staging --outdir .wrangler-dist/runtime-test && node --test test/runtime.test.mjs",
    "typecheck": "tsc",
    "check:deploy": "wrangler deploy --dry-run --env staging --outdir .wrangler-dist/staging && wrangler deploy --dry-run --env production --outdir .wrangler-dist/production",
    "check": "npm test && npm run typecheck && npm run test:runtime && npm run check:deploy && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "partyserver": "^0.4.0",
    "y-partyserver": "^2.1.4",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250313.0",
    "miniflare": "4.20260401.0",
    "typescript": "^5.7.0",
    "ws": "8.18.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "nanoid": "5.1.16"
  }
}
